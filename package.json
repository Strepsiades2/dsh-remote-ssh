{
  "name": "@strepsiades/dsh-remote-ssh",
  "version": "0.7.0",
  "private": false,
  "description": "SSH remote hosts for DeepSeek Harness: pick a host from ~/.ssh/config, keep an \"SSH local forward, and open its DSH web UI in the browser.",
  "author": "Strepsiades",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "ssh-tunnel",
    "remote",
    "port-forward"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Strepsiades2/dsh-remote-ssh.git"
  },
  "homepage": "https://github.com/Strepsiades2/dsh-remote-ssh#readme",
  "bugs": {
    "url": "https://github.com/Strepsiades2/dsh-remote-ssh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
